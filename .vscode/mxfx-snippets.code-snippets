{
  // Place your duckhunt workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
  // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
  // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
  // used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
  // Placeholders with the same ids are connected.
  // Example:
  // "Print to console": {
  // 	"scope": "javascript,typescript",
  // 	"prefix": "log",
  // 	"body": [
  // 		"console.log('$1');",
  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }
  "effect-gen": {
    "scope": "typescript",
    "prefix": "egen",
    "body": "Effect.gen(function* () {${0}})",
  },
  "effect-gen-fn": {
    "scope": "typescript",
    "prefix": "egenfn",
    "body": "(${1}) => Effect.gen(function* () {${0}})",
  },
  "effect-fn": {
    "scope": "typescript",
    "prefix": "efn",
    "body": "Effect.fn(function* () {${0}})",
  },

  "mxfx-endpoint": {
    "scope": "typescript",
    "prefix": "mxfx-endpoint",
    "body": [
      "import { Schema } from 'effect'",
      "import { makeEndpoint } from '../endpoint.ts'",
      "",
      "const schema = Schema.Struct({${0}})",
      "",
      "/**",
      " * `${1:GET} /_matrix/client/${2:path}`",
      " *",
      " * @description",
      " * ${3:description}",
      " *",
      " * @see ${4:documentationUrl} ",
      " */",
      "export const ${5:getEndpoint} = () => makeEndpoint('${1:GET}', { auth: ${6:true}, schema })`'/${2:path}'`",
      "",
    ],
  },
}
